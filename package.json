{
  "name": "@erp/moldura",
  "version": "0.4.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./estilo.css": "./dist/estilo.css",
    "./servidor": {
      "types": "./dist/servidor.d.ts",
      "default": "./dist/servidor.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/estilo.css dist/estilo.css",
    "test": "pnpm build && node --experimental-test-module-mocks --test test/*.test.mjs",
    "publicar": "pnpm build && pnpm publish --no-git-checks --registry http://localhost:4873"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "dependencies": {
    "@erp/contratos": "0.2.1"
  }
}
